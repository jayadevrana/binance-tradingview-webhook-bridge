# ─────────────────────────────────────────────────────────────────────────
#  Binance × TradingView Webhook Bridge — configuration
#  Copy to `.env` and fill in.  Real environment variables override this file.
# ─────────────────────────────────────────────────────────────────────────

# ── Binance Futures API (create at binance.com → API Management) ──────────
BINANCE_API_KEY=
BINANCE_API_SECRET=
# true  -> https://testnet.binancefuture.com  (fake money, separate keys)
# false -> https://fapi.binance.com           (LIVE, real money)
BINANCE_TESTNET=false

# ── Position sizing ──────────────────────────────────────────────────────
# margin   -> notional = FUND * LVG   (FUND is collateral you commit)  [chosen]
# notional -> notional = FUND         (LVG only sets margin locked)
FUND_MODE=margin
DEFAULT_LEVERAGE=20
# off | ISOLATED | CROSSED   (off = leave the symbol's margin type untouched) [chosen]
SET_MARGIN_TYPE=off
# oneway -> positionSide BOTH, reduceOnly closes.  Account MUST be one-way mode.
POSITION_MODE=oneway

# ── Safety rails ─────────────────────────────────────────────────────────
# START WITH true.  Simulates every order (reads prices/positions, places nothing).
# Flip to false only after you've watched one alert flow end-to-end in the logs.
DRY_RUN=true
# Reject any single order whose notional exceeds this many USDT (0 = no cap).
MAX_NOTIONAL_USDT=5000
RECV_WINDOW=5000

# ── Webhook security ─────────────────────────────────────────────────────
# Long random string. It becomes part of the URL: /webhook/<WEBHOOK_TOKEN>
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_TOKEN=
# Comma-separated source IPs allowed to POST. TradingView's documented IPs are
# pre-filled below; leave EMPTY to allow any source (not recommended).
IP_ALLOWLIST=52.89.214.238,34.212.75.30,54.218.53.128,52.32.178.7

# ── Server ───────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO
